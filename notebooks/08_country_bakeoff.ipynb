   "source": [
    "RAW_PATH = repo_path(\"data\", \"raw\", \"ucdp\", \"ged_four_countries.parquet\")\n",
    "WEEKLY_PATH = repo_path(\"data\", \"processed\", \"country_bakeoff_weekly.parquet\")\n",
    "START = pd.Timestamp(\"2014-01-06\")  # Monday\n",
    "\n",
    "\n",
    "def load_events() -> pd.DataFrame:\n",
    "    ev = pd.read_parquet(RAW_PATH)\n",
    "    ev[\"date\"] = pd.to_datetime(ev[\"date_start\"]).dt.normalize()\n",
    "    ev[\"week_start\"] = ev[\"date\"] - pd.to_timedelta(ev[\"date\"].dt.weekday, unit=\"D\")\n",
    "    id_to_code = {v[\"ucdp_id\"]: k for k, v in COUNTRIES.items()}\n",
    "    ev[\"code\"] = ev[\"country_id\"].map(id_to_code)\n",
    "    return ev.dropna(subset=[\"code\"]).copy()\n",
    "\n",
    "\n",
    "def build_weekly(events: pd.DataFrame) -> pd.DataFrame:\n",
    "    last = events[\"week_start\"].max()\n",
    "    idx = pd.date_range(START, last, freq=\"W-MON\")\n",
    "    parts = []\n",
    "    for code, g in events.groupby(\"code\"):\n",
    "        w = (\n",
    "            g.groupby(\"week_start\")\n",
    "            .agg(conflict_count=(\"id\", \"size\"), fatalities=(\"best\", \"sum\"))\n",
    "            .reindex(idx, fill_value=0)\n",
    "            .rename_axis(\"week_start\")\n",
    "            .reset_index()\n",
    "        )\n",
    "        w[\"code\"] = code\n",
    "        w[\"country\"] = COUNTRIES[code][\"name\"]\n",
    "        w[\"week_label\"] = w[\"week_start\"].dt.date.map(iso_week_label)\n",
    "        parts.append(w)\n",
    "    panel = pd.concat(parts, ignore_index=True)\n",
    "    panel[\"week_start\"] = pd.to_datetime(panel[\"week_start\"]).dt.date\n",
    "    return panel.sort_values([\"code\", \"week_start\"]).reset_index(drop=True)\n",
    "\n",
    "\n",
    "events = load_events()\n",
    "if WEEKLY_PATH.exists():\n",
    "    weekly = pd.read_parquet(WEEKLY_PATH)\n",
    "    weekly[\"week_start\"] = pd.to_datetime(weekly[\"week_start\"]).dt.date\n",
    "else:\n",
    "    weekly = build_weekly(events)\n",
    "    weekly.to_parquet(WEEKLY_PATH, index=False)\n",
    "\n",
    "print(\n",
    "    f\"events={len(events):,}  weekly={len(weekly):,}  \"\n",
    "    f\"{weekly['week_start'].min()} .. {weekly['week_start'].max()}\"\n",
    ")\n",
    "weekly.groupby(\"code\").agg(\n",
    "    weeks=(\"conflict_count\", \"size\"),\n",
    "    events=(\"conflict_count\", \"sum\"),\n",
    "    mean=(\"conflict_count\", \"mean\"),\n",
    "    median=(\"conflict_count\", \"median\"),\n",
    "    zeros=(\"conflict_count\", lambda s: (s == 0).mean()),\n",
    "    max=(\"conflict_count\", \"max\"),\n",
    "    fatalities=(\"fatalities\", \"sum\"),\n",
    ").loc[ORDER]\n"
   ]
  },
