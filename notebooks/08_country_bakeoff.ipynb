    "WIKI_DIR = repo_path(\"data\", \"raw\", \"wikipedia\")\n",
    "WIKI_DIR.mkdir(parents=True, exist_ok=True)\n",
    "UA = \"GDETL-country-bakeoff/1.0 (research notebook; local)\"\n",
    "\n",
    "\n",
    "def fetch_pageviews(title: str, start=\"20150701\", end=\"20260630\") -> pd.Series:\n",
    "    cache = WIKI_DIR / f\"{title.replace('/', '_')}.csv\"\n",
    "    if cache.exists():\n",
    "        s = pd.read_csv(cache, parse_dates=[\"date\"]).set_index(\"date\")[\"views\"]\n",
    "        return s\n",
    "    url = (\n",
    "        \"https://wikimedia.org/api/rest_v1/metrics/pageviews/per-article/\"\n",
    "        f\"en.wikipedia/all-access/user/{title}/daily/{start}/{end}\"\n",
    "    )\n",
    "    try:\n",
    "        r = requests.get(url, headers={\"User-Agent\": UA}, timeout=40)\n",
    "        r.raise_for_status()\n",
    "        items = r.json().get(\"items\", [])\n",
    "    except Exception as exc:\n",
    "        print(f\"  wiki miss {title}: {exc}\")\n",
    "        return pd.Series(dtype=float, name=\"views\")\n",
    "    df = pd.DataFrame(items)\n",
    "    if df.empty:\n",
    "        return pd.Series(dtype=float, name=\"views\")\n",
    "    df[\"date\"] = pd.to_datetime(df[\"timestamp\"].str[:8])\n",
    "    s = df.set_index(\"date\")[\"views\"].astype(float)\n",
    "    s.to_csv(cache, index_label=\"date\")\n",
    "    return s\n",
    "\n",
    "\n",
    "wiki_weekly = {}\n",
    "for code in ORDER:\n",
    "    series = []\n",
    "    for title in COUNTRIES[code][\"wiki\"]:\n",
    "        s = fetch_pageviews(title)\n",
    "        if len(s):\n",
    "            series.append(s)\n",
    "            print(f\"{code}  {title}: {len(s)} days\")\n",
    "    if not series:\n",
    "        wiki_weekly[code] = None\n",
    "        continue\n",
    "    daily = pd.concat(series, axis=1).sum(axis=1).rename(\"wiki_views\")\n",
    "    w = daily.resample(\"W-MON\").sum()\n",
    "    w.index = w.index.date\n",
    "    wiki_weekly[code] = w\n",
    "\n",
    "# leading-indicator check: corr(wiki_t, y_{t+1}) vs corr(y_t, y_{t+1})\n",
    "lead_rows = []\n",
    "for code in ORDER:\n",
    "    sub = weekly[weekly[\"code\"] == code].copy()\n",
    "    sub[\"week_start\"] = pd.to_datetime(sub[\"week_start\"]).dt.date\n",
    "    y = sub.set_index(\"week_start\")[\"conflict_count\"].astype(float)\n",
    "    w = wiki_weekly.get(code)\n",
    "    if w is None or w.empty:\n",
    "        lead_rows.append(dict(code=code, wiki_lead_corr=np.nan, ar1=np.nan, wiki_partial=np.nan))\n",
    "        continue\n",
    "    aligned = pd.DataFrame({\"y\": y, \"wiki\": w.reindex(y.index)}).dropna()\n",
    "    y0, y1 = aligned[\"y\"].to_numpy()[:-1], aligned[\"y\"].to_numpy()[1:]\n",
    "    w0 = aligned[\"wiki\"].to_numpy()[:-1]\n",
    "    ar1 = float(np.corrcoef(y0, y1)[0, 1])\n",
    "    wlead = float(np.corrcoef(w0, y1)[0, 1])\n",
    "    # partial: residual of y1 ~ y0, correlated with wiki\n",
    "    resid = y1 - ar1 * y0\n",
    "    partial = float(np.corrcoef(w0, resid)[0, 1]) if resid.std() > 0 else np.nan\n",
    "    lead_rows.append(dict(code=code, n=len(aligned), ar1=ar1, wiki_lead_corr=wlead, wiki_partial=partial))\n",
    "\n",
    "lead_df = pd.DataFrame(lead_rows).set_index(\"code\").loc[ORDER]\n",
    "lead_df.round(3)\n"
   ]
