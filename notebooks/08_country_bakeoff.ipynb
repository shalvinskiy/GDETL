   "source": [
    "from statsmodels.tsa.seasonal import STL\n",
    "\n",
    "\n",
    "def stl_strengths(y: np.ndarray, period: int = 52) -> tuple[float, float]:\n",
    "    y = np.asarray(y, dtype=float)\n",
    "    if len(y) < period * 2:\n",
    "        return np.nan, np.nan\n",
    "    res = STL(y, period=period, robust=True).fit()\n",
    "    # Hyndman: seasonal strength = max(0, 1 - Var(R) / Var(S+R))\n",
    "    vr = np.var(res.resid)\n",
    "    seas = max(0.0, 1.0 - vr / (np.var(res.seasonal + res.resid) + 1e-12))\n",
    "    trend = max(0.0, 1.0 - vr / (np.var(res.trend + res.resid) + 1e-12))\n",
    "    return float(seas), float(trend)\n",
    "\n",
    "\n",
    "def n_level_shifts(y: pd.Series, window: int = 26, ratio: float = 2.0) -> int:\n",
    "    m = y.rolling(window, min_periods=window).mean()\n",
    "    prev = m.shift(window)\n",
    "    rel = m / prev.replace(0, np.nan)\n",
    "    # a shift is a week where the local mean has doubled or halved vs a year-half ago\n",
    "    flag = (rel >= ratio) | (rel <= 1.0 / ratio)\n",
    "    # collapse runs into events\n",
    "    return int((flag.fillna(False) & ~flag.shift(1).fillna(False)).sum())\n",
    "\n",
    "\n",
    "def interspike_cv(y: pd.Series, k: float = 2.0) -> float:\n",
    "    shifted = y.shift(1)\n",
    "    thr = shifted.rolling(52, min_periods=16).mean() + k * shifted.rolling(52, min_periods=16).std()\n",
    "    spikes = (y > thr).fillna(False).to_numpy()\n",
    "    idx = np.flatnonzero(spikes)\n",
    "    if len(idx) < 4:\n",
    "        return np.nan\n",
    "    gaps = np.diff(idx)\n",
    "    return float(gaps.std() / (gaps.mean() + 1e-9))\n",
    "\n",
    "\n",
    "diag_rows = []\n",
    "for code in ORDER:\n",
    "    sub = weekly[weekly[\"code\"] == code].copy()\n",
    "    y = sub[\"conflict_count\"].astype(float)\n",
    "    arr = y.to_numpy()\n",
    "    ar1 = float(np.corrcoef(arr[1:], arr[:-1])[0, 1])\n",
    "    seas, trend = stl_strengths(arr)\n",
    "    try:\n",
    "        adf_p = float(adfuller(arr, autolag=\"AIC\")[1])\n",
    "    except Exception:\n",
    "        adf_p = np.nan\n",
    "    acf_vals = acf(arr, nlags=52, fft=True)\n",
    "    diag_rows.append(dict(\n",
    "        code=code,\n",
    "        country=COUNTRIES[code][\"name\"],\n",
    "        claim=COUNTRIES[code][\"claim\"],\n",
    "        ar1=ar1,\n",
    "        residual_after_ar1=1 - ar1**2,\n",
    "        acf52=float(acf_vals[52]),\n",
    "        stl_seasonal=seas,\n",
    "        stl_trend=trend,\n",
    "        adf_pvalue=adf_p,\n",
    "        n_level_shifts=n_level_shifts(y),\n",
    "        spike_gap_cv=interspike_cv(y),\n",
    "        share_zero=float((arr == 0).mean()),\n",
    "        cv=float(arr.std() / (arr.mean() + 1e-9)),\n",
    "    ))\n",
    "\n",
    "diag = pd.DataFrame(diag_rows).set_index(\"code\").loc[ORDER]\n",
    "# XGBoost-opportunity heuristic (higher = more leftover structure, fewer breaks)\n",
    "diag[\"xgb_opportunity\"] = (\n",
    "    0.30 * diag[\"residual_after_ar1\"].clip(0, 1)\n",
    "    + 0.30 * diag[\"stl_seasonal\"].clip(0, 1)\n",
    "    + 0.20 * (1 - diag[\"ar1\"].clip(0, 1))\n",
    "    + 0.20 * (1 / (1 + diag[\"n_level_shifts\"]))\n",
    ")\n",
    "diag.round(3)\n"
   ]
  },
