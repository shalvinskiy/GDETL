    "def _annotate(ax, code):\n",
    "    ymin, ymax = ax.get_ylim()\n",
    "    for dt_str, label in COUNTRIES[code][\"breaks\"]:\n",
    "        ts = pd.Timestamp(dt_str)\n",
    "        ax.axvline(ts, color=\"0.35\", ls=\"--\", lw=0.9, alpha=0.8)\n",
    "        ax.text(ts, ymax * 0.92, label, rotation=90, va=\"top\", ha=\"right\",\n",
    "                fontsize=7.5, color=\"0.25\")\n",
    "\n",
    "\n",
    "fig, axes = plt.subplots(4, 1, figsize=(13, 11), sharex=True)\n",
    "for ax, code in zip(axes, ORDER):\n",
    "    sub = weekly[weekly[\"code\"] == code]\n",
    "    t = pd.to_datetime(sub[\"week_start\"])\n",
    "    ax.plot(t, sub[\"conflict_count\"], color=COUNTRIES[code][\"color\"], lw=1.0, label=\"events / week\")\n",
    "    ax2 = ax.twinx()\n",
    "    ax2.plot(t, sub[\"fatalities\"], color=\"0.55\", lw=0.7, alpha=0.7, label=\"fatalities\")\n",
    "    ax2.set_ylabel(\"fatalities\", color=\"0.45\")\n",
    "    ax.set_ylabel(\"events / week\")\n",
    "    ax.set_title(f\"{code}  {COUNTRIES[code]['name']}  —  {COUNTRIES[code]['claim']}\", loc=\"left\")\n",
    "    _annotate(ax, code)\n",
    "fig.suptitle(\"Weekly UCDP lethal-violence events (filled) and fatalities (grey)\", y=1.01)\n",
    "fig.tight_layout()\n",
    "fig.savefig(FIG_DIR / \"01_history.png\", dpi=130, bbox_inches=\"tight\")\n",
    "plt.show()\n"
   ]
