    "def predict_seasonal_naive(df: pd.DataFrame, horizon: int) -> np.ndarray:\n",
    "    col = f\"seasonal_naive_h{horizon}\"\n",
    "    if col in df.columns:\n",
    "        vals = df[col].to_numpy(dtype=float)\n",
    "    else:\n",
    "        vals = df[\"conflict_count_lag12\"].to_numpy(dtype=float)\n",
    "    fallback = df[\"conflict_count_t0\"].to_numpy(dtype=float)\n",
    "    return np.where(np.isnan(vals), fallback, vals)\n",
    "\n",
    "\n",
    "def attach_seasonal_naive(df: pd.DataFrame) -> pd.DataFrame:\n",
    "    df = df.copy()\n",
    "    for h in HORIZONS:\n",
    "        # y_{t+h} ≈ y_{t+h-52} which, at origin t, is conflict_count.shift(52-h)\n",
    "        df[f\"seasonal_naive_h{h}\"] = df[\"conflict_count\"].shift(52 - h)\n",
    "    return df\n",
    "\n",
    "\n",
    "def run_country_cv(feat: pd.DataFrame, code: str):\n",
    "    feat = attach_seasonal_naive(feat)\n",
    "    cv_pool, full_df, holdout_start, holdout_weeks = split_holdout(feat, 12, max(HORIZONS))\n",
    "    folds = generate_folds(len(cv_pool), initial_train_weeks=104, step_weeks=8, min_test_weeks=4)\n",
    "    models = [\"baseline_naive\", \"baseline_rollingmean\", \"seasonal_naive\", \"ets\", \"xgboost\"]\n",
    "    bag = {h: {m: {\"y_true\": [], \"y_pred\": []} for m in models} for h in HORIZONS_CV}\n",
    "\n",
    "    for train_range, test_range in folds:\n",
    "        train_df = cv_pool.iloc[list(train_range)]\n",
    "        test_df = cv_pool.iloc[list(test_range)]\n",
    "        n_test = len(test_df)\n",
    "        ets_fc = stat_model.fit_and_forecast(train_df[\"conflict_count\"], steps=n_test + max(HORIZONS_CV))\n",
    "        for h in HORIZONS_CV:\n",
    "            tgt = f\"target_count_h{h}\"\n",
    "            y_true = test_df[tgt].to_numpy(dtype=float)\n",
    "            valid = ~np.isnan(y_true)\n",
    "            if valid.sum() == 0:\n",
    "                continue\n",
    "            preds = {\n",
    "                \"baseline_naive\": baseline.predict_naive(test_df, h),\n",
    "                \"baseline_rollingmean\": baseline.predict_rolling_mean(test_df, h),\n",
    "                \"seasonal_naive\": predict_seasonal_naive(test_df, h),\n",
    "                \"ets\": ets_fc[h - 1: h - 1 + n_test],\n",
    "                \"xgboost\": ml_model.fit_predict_regressor(train_df, test_df, FEATURE_COLS, tgt, SEED),\n",
    "            }\n",
    "            for m in models:\n",
    "                bag[h][m][\"y_true\"].append(y_true[valid])\n",
    "                bag[h][m][\"y_pred\"].append(np.asarray(preds[m])[valid])\n",
    "\n",
    "    hist = cv_pool[\"conflict_count\"].to_numpy(dtype=float)\n",
    "    summary = {}\n",
    "    for h, ms in bag.items():\n",
    "        summary[h] = {}\n",
    "        for m, d in ms.items():\n",
    "            if not d[\"y_true\"]:\n",
    "                continue\n",
    "            yt, yp = np.concatenate(d[\"y_true\"]), np.concatenate(d[\"y_pred\"])\n",
    "            summary[h][m] = regression_report(yt, yp, hist)\n",
    "    print(f\"{code}: {len(folds)} CV folds, hold-out from {holdout_start}, cv_pool={len(cv_pool)}\")\n",
    "    return summary, cv_pool, full_df, holdout_weeks, folds\n",
    "\n",
    "\n",
    "def run_country_holdout(cv_pool, full_df, holdout_weeks):\n",
    "    import datetime as dt\n",
    "    full_df = attach_seasonal_naive(full_df)\n",
    "    models = [\"baseline_naive\", \"baseline_rollingmean\", \"seasonal_naive\", \"ets\", \"xgboost\"]\n",
    "    max_h = max(HORIZONS)\n",
    "    cv_last = pd.to_datetime(cv_pool[\"week_start\"]).max()\n",
    "    last_week = pd.to_datetime(full_df[\"week_start\"]).max()\n",
    "    ets_steps = int((last_week - cv_last) / pd.Timedelta(weeks=1)) + max_h\n",
    "    ets_fc = stat_model.fit_and_forecast(cv_pool[\"conflict_count\"], steps=ets_steps)\n",
    "    out = {}\n",
    "    for h in HORIZONS:\n",
    "        target_origins = {w - dt.timedelta(weeks=h) for w in holdout_weeks}\n",
    "        test_df = full_df[full_df[\"week_start\"].isin(target_origins)].sort_values(\"week_start\")\n",
    "        y_true = test_df[f\"target_count_h{h}\"].to_numpy(dtype=float)\n",
    "        valid = ~np.isnan(y_true)\n",
    "        steps_ahead = (\n",
    "            (pd.to_datetime(test_df[\"week_start\"]) + pd.Timedelta(weeks=h) - cv_last)\n",
    "            / pd.Timedelta(weeks=1)\n",
    "        ).astype(int)\n",
    "        preds = {\n",
    "            \"baseline_naive\": baseline.predict_naive(test_df, h),\n",
    "            \"baseline_rollingmean\": baseline.predict_rolling_mean(test_df, h),\n",
    "            \"seasonal_naive\": predict_seasonal_naive(test_df, h),\n",
    "            \"ets\": ets_fc[steps_ahead.to_numpy() - 1],\n",
    "            \"xgboost\": ml_model.fit_predict_regressor(cv_pool, test_df, FEATURE_COLS, f\"target_count_h{h}\", SEED),\n",
    "        }\n",
    "        out[h] = {\n",
    "            m: {\n",
    "                **regression_report(y_true[valid], np.asarray(preds[m])[valid], cv_pool[\"conflict_count\"].to_numpy()),\n",
    "                \"y_true\": y_true[valid].tolist(),\n",
    "                \"y_pred\": np.asarray(preds[m])[valid].tolist(),\n",
    "                \"week\": [str(w) for w, ok in zip(test_df[\"week_start\"], valid) if ok],\n",
    "            }\n",
    "            for m in models\n",
    "        }\n",
    "    return out\n",
    "\n",
    "\n",
    "cv_summaries, holdout_summaries, cv_meta = {}, {}, {}\n",
    "for code in ORDER:\n",
    "    feat = features[code]\n",
    "    cv_sum, cv_pool, full_df, holdout_weeks, folds = run_country_cv(feat, code)\n",
    "    ho = run_country_holdout(cv_pool, full_df, holdout_weeks)\n",
    "    cv_summaries[code] = cv_sum\n",
    "    holdout_summaries[code] = ho\n",
    "    cv_meta[code] = dict(n_folds=len(folds), n_cv=len(cv_pool), holdout_n=len(holdout_weeks))\n",
    "cv_meta\n"
   ]
  },
