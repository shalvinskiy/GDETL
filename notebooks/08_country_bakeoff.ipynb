    "def flatten(summaries, tag):\n",
    "    rows = []\n",
    "    for code, by_h in summaries.items():\n",
    "        for h, models in by_h.items():\n",
    "            naive = models[\"baseline_naive\"][\"MASE\"]\n",
    "            for m, rep in models.items():\n",
    "                lift = None if m == \"baseline_naive\" or not naive else (naive - rep[\"MASE\"]) / naive * 100\n",
    "                rows.append(dict(\n",
    "                    split=tag, code=code, country=COUNTRIES[code][\"name\"],\n",
    "                    horizon=h, model=m,\n",
    "                    MASE=rep[\"MASE\"], sMAPE=rep[\"sMAPE\"], RMSE=rep[\"RMSE\"], MAE=rep[\"MAE\"],\n",
    "                    vs_naive_pct=lift, n=rep[\"n\"],\n",
    "                ))\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "cv_tbl = flatten(cv_summaries, \"cv\")\n",
    "ho_tbl = flatten(holdout_summaries, \"holdout\")\n",
    "\n",
    "cv_h = cv_tbl[cv_tbl[\"horizon\"].isin([1, 4])]\n",
    "rank = (\n",
    "    cv_h.pivot_table(index=[\"code\", \"country\"], columns=\"model\", values=\"MASE\", aggfunc=\"mean\")\n",
    "    [[\"baseline_naive\", \"baseline_rollingmean\", \"seasonal_naive\", \"ets\", \"xgboost\"]]\n",
    ")\n",
    "rank[\"xgb_vs_naive_pct\"] = (rank[\"baseline_naive\"] - rank[\"xgboost\"]) / rank[\"baseline_naive\"] * 100\n",
    "rank[\"xgb_vs_best_simple_pct\"] = (\n",
    "    rank[[\"baseline_naive\", \"baseline_rollingmean\", \"seasonal_naive\", \"ets\"]].min(axis=1) - rank[\"xgboost\"]\n",
    ") / rank[[\"baseline_naive\", \"baseline_rollingmean\", \"seasonal_naive\", \"ets\"]].min(axis=1) * 100\n",
    "if isinstance(rank.index, pd.MultiIndex):\n",
    "    rank = rank.droplevel(\"country\")\n",
    "rank = rank.loc[ORDER]\n",
    "print(\"Walk-forward CV MASE (mean of h=1 and h=4)\")\n",
    "display(rank.round(3))\n",
    "\n",
    "print(\"\\nPer-horizon CV MASE\")\n",
    "piv = cv_tbl.pivot_table(index=[\"code\", \"horizon\"], columns=\"model\", values=\"MASE\")\n",
    "display(piv.loc[ORDER].round(3))\n"
   ]
