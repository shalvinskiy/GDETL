    "import holidays as pyholidays\n",
    "\n",
    "FEATURE_COLS = [\n",
    "    \"conflict_count_t0\",\n",
    "    \"conflict_count_lag1\", \"conflict_count_lag2\", \"conflict_count_lag4\", \"conflict_count_lag12\",\n",
    "    \"rolling_mean_4w\", \"rolling_std_12w\", \"rolling_max_8w\", \"rolling_mean_12w\",\n",
    "    \"week_of_year\", \"month\", \"is_holiday\",\n",
    "    \"weeks_since_major_spike\", \"cumulative_conflict_12w\",\n",
    "    \"fatalities_lag1\", \"rolling_fatalities_4w\",\n",
    "    \"wiki_views\", \"wiki_views_lag1\", \"wiki_views_change_wow\",\n",
    "]\n",
    "\n",
    "\n",
    "def build_country_features(panel: pd.DataFrame, code: str) -> pd.DataFrame:\n",
    "    df = panel[panel[\"code\"] == code].sort_values(\"week_start\").reset_index(drop=True).copy()\n",
    "    df[\"week_start\"] = pd.to_datetime(df[\"week_start\"]).dt.date\n",
    "    df[\"days_covered\"] = 7\n",
    "    for h in HORIZONS:\n",
    "        df[f\"target_count_h{h}\"] = df[\"conflict_count\"].shift(-h).astype(float)\n",
    "    df = add_escalation_label(df, cfg)\n",
    "    for h in HORIZONS:\n",
    "        df[f\"target_event_h{h}\"] = df[\"escalation_event\"].shift(-h)\n",
    "\n",
    "    df[\"conflict_count_t0\"] = df[\"conflict_count\"]\n",
    "    for k in (1, 2, 4, 12):\n",
    "        df[f\"conflict_count_lag{k}\"] = df[\"conflict_count\"].shift(k)\n",
    "    df[\"rolling_mean_4w\"] = df[\"conflict_count\"].rolling(4, min_periods=2).mean()\n",
    "    df[\"rolling_std_12w\"] = df[\"conflict_count\"].rolling(12, min_periods=4).std()\n",
    "    df[\"rolling_max_8w\"] = df[\"conflict_count\"].rolling(8, min_periods=2).max()\n",
    "    df[\"rolling_mean_12w\"] = df[\"conflict_count\"].rolling(12, min_periods=4).mean()\n",
    "    df[\"cumulative_conflict_12w\"] = df[\"conflict_count\"].rolling(12, min_periods=4).sum()\n",
    "\n",
    "    spike = df[\"conflict_count\"] > (\n",
    "        df[\"conflict_count\"].shift(1).rolling(52, min_periods=16).mean()\n",
    "        + 2 * df[\"conflict_count\"].shift(1).rolling(52, min_periods=16).std()\n",
    "    )\n",
    "    df[\"weeks_since_major_spike\"] = _weeks_since_last_true(spike.fillna(False))\n",
    "\n",
    "    ws = pd.to_datetime(df[\"week_start\"])\n",
    "    df[\"week_of_year\"] = ws.dt.isocalendar().week.astype(int)\n",
    "    df[\"month\"] = ws.dt.month\n",
    "    try:\n",
    "        hols = pyholidays.country_holidays(COUNTRIES[code][\"iso2\"])\n",
    "        df[\"is_holiday\"] = ws.apply(lambda d: int(any((d + pd.Timedelta(days=i)) in hols for i in range(7))))\n",
    "    except Exception:\n",
    "        df[\"is_holiday\"] = 0\n",
    "\n",
    "    df[\"fatalities_lag1\"] = df[\"fatalities\"].shift(1)\n",
    "    df[\"rolling_fatalities_4w\"] = df[\"fatalities\"].shift(1).rolling(4, min_periods=2).mean()\n",
    "\n",
    "    w = wiki_weekly.get(code)\n",
    "    if w is not None and len(w):\n",
    "        df[\"wiki_views\"] = df[\"week_start\"].map(lambda d: w.get(d, np.nan))\n",
    "    else:\n",
    "        df[\"wiki_views\"] = np.nan\n",
    "    df[\"wiki_views_lag1\"] = df[\"wiki_views\"].shift(1)\n",
    "    df[\"wiki_views_change_wow\"] = df[\"wiki_views\"].pct_change().replace([np.inf, -np.inf], np.nan)\n",
    "    return df\n",
    "\n",
    "\n",
    "features = {code: build_country_features(weekly, code) for code in ORDER}\n",
    "{c: f.shape for c, f in features.items()}\n"
   ]
