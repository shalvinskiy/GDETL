   "source": [
    "BREAK_TESTS = {\n",
    "    \"IS\": \"2023-10-02\",   # Monday before 7 Oct\n",
    "    \"SU\": \"2023-04-10\",   # Monday before 15 Apr\n",
    "    \"BM\": \"2021-02-01\",\n",
    "    \"YM\": \"2022-04-04\",\n",
    "}\n",
    "\n",
    "\n",
    "def prepost_eval(code: str, cutoff: str, test_weeks: int = 26, h: int = 1):\n",
    "    feat = attach_seasonal_naive(features[code])\n",
    "    feat = feat.copy()\n",
    "    feat[\"_t\"] = pd.to_datetime(feat[\"week_start\"])\n",
    "    cut = pd.Timestamp(cutoff)\n",
    "    train = feat[feat[\"_t\"] <= cut]\n",
    "    origins = feat[(feat[\"_t\"] > cut) & (feat[\"_t\"] <= cut + pd.Timedelta(weeks=test_weeks))]\n",
    "    tgt = f\"target_count_h{h}\"\n",
    "    origins = origins.dropna(subset=[tgt])\n",
    "    if len(train) < 40 or len(origins) < 4:\n",
    "        return None\n",
    "    y_true = origins[tgt].to_numpy(dtype=float)\n",
    "    preds = {\n",
    "        \"baseline_naive\": baseline.predict_naive(origins, h),\n",
    "        \"baseline_rollingmean\": baseline.predict_rolling_mean(origins, h),\n",
    "        \"seasonal_naive\": predict_seasonal_naive(origins, h),\n",
    "        \"ets\": stat_model.fit_and_forecast(train[\"conflict_count\"], steps=len(origins) + h)[h - 1: h - 1 + len(origins)],\n",
    "        \"xgboost\": ml_model.fit_predict_regressor(train, origins, FEATURE_COLS, tgt, SEED),\n",
    "    }\n",
    "    hist = train[\"conflict_count\"].to_numpy(dtype=float)\n",
    "    return {m: regression_report(y_true, np.asarray(p), hist) for m, p in preds.items()} | {\"n_train\": len(train), \"n_test\": len(origins)}\n",
    "\n",
    "\n",
    "pp_rows = []\n",
    "for code, cut in BREAK_TESTS.items():\n",
    "    rep = prepost_eval(code, cut)\n",
    "    if not rep:\n",
    "        continue\n",
    "    naive = rep[\"baseline_naive\"][\"MASE\"]\n",
    "    for m in [\"baseline_naive\", \"baseline_rollingmean\", \"seasonal_naive\", \"ets\", \"xgboost\"]:\n",
    "        lift = None if m == \"baseline_naive\" else (naive - rep[m][\"MASE\"]) / naive * 100\n",
    "        pp_rows.append(dict(\n",
    "            code=code, cutoff=cut, n_train=rep[\"n_train\"], n_test=rep[\"n_test\"],\n",
    "            model=m, MASE=rep[m][\"MASE\"], RMSE=rep[m][\"RMSE\"], vs_naive_pct=lift,\n",
    "        ))\n",
    "pp = pd.DataFrame(pp_rows)\n",
    "display(pp.pivot(index=\"code\", columns=\"model\", values=\"MASE\").round(3))\n",
    "print(\"XGBoost vs naive % after the break (positive = XGB wins — not expected):\")\n",
    "print(pp[pp[\"model\"] == \"xgboost\"][[\"code\", \"cutoff\", \"vs_naive_pct\", \"n_train\", \"n_test\"]].round(1).to_string(index=False))\n"
   ]
